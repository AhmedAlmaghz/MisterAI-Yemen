    },
    {
      "topLeftX": 83,
      "topLeftY": 746,
      "bottomRightX": 287,
      "bottomRightY": 762,
      "content": "Good keyboard skills are essential.",
      "type": "text"
    },
    {
      "topLeftX": 83,
      "topLeftY": 762,
      "bottomRightX": 394,
      "bottomRightY": 779,
      "content": "All our sales people have good communication skills.",
      "type": "text"
    },
    {
      "topLeftX": 83,
      "topLeftY": 791,
